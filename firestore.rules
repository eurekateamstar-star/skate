rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 登入 token 裡帶有 empId（由 Worker 發出），並且必須和員工資料上的 LINE 綁定一致
    function empPath(id) { return /databases/$(database)/documents/employees/$(id); }
    function myEmpId() { return request.auth.token.empId; }
    function bound() {
      return request.auth != null
        && request.auth.token.empId is string
        && exists(empPath(myEmpId()))
        && get(empPath(myEmpId())).data.lineUid == request.auth.uid
        && get(empPath(myEmpId())).data.active != false;
    }
    function isAdmin() { return bound() && get(empPath(myEmpId())).data.role == 'admin'; }

    // 員工資料：管理者可讀寫；員工只能讀自己（綁定由 Worker 以管理員權限寫入）
    match /employees/{id} {
      allow read: if isAdmin() || (bound() && id == myEmpId());
      allow write: if isAdmin();
    }

    // 班別：已綁定員工可讀，管理者可改
    match /shiftTypes/{id} {
      allow read: if bound();
      allow write: if isAdmin();
    }

    // 班表：員工只能查詢自己的；單一天可讀（選代班人時檢查對方那天有沒有班）
    match /schedules/{id} {
      allow get: if bound();
      allow list: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow write: if isAdmin();
    }

    // 員工姓名名單（選代班人用，只有 id、姓名、員編）
    match /meta/{id} {
      allow read: if bound();
      allow write: if isAdmin();
    }

    // 班表設定（名稱、班別、人員、檢視權限）
    match /rosters/{month} {
      allow read: if bound();
      allow write: if isAdmin();
    }

    // 已發布的全部人班表（檢視權限為「全部人」時才會產生）
    match /rosterPublic/{month} {
      allow read: if bound();
      allow write: if isAdmin();
    }

    // 員工看過審核結果：只能把自己的 seenByEmp 改成 true
    function seenOnly() {
      return bound() && resource.data.empId == myEmpId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByEmp'])
        && request.resource.data.seenByEmp == true;
    }

    // 補打卡申請：員工只能用自己的身分送出（待審核），管理者審核
    match /punchRequests/{id} {
      allow read: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow create: if bound()
                    && request.resource.data.empId == myEmpId()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() >= 2;
      allow update: if isAdmin() || seenOnly();
      allow delete: if isAdmin();
    }

    // 請假申請：員工送出、可修改／取消審核中的；管理者審核、修改、指定代班
    match /leaveRequests/{id} {
      allow read: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow create: if bound()
                    && request.resource.data.empId == myEmpId()
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || seenOnly()
                    || (bound() && resource.data.empId == myEmpId() && resource.data.status == 'pending'
                        && request.resource.data.empId == myEmpId() && request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (bound() && resource.data.empId == myEmpId() && resource.data.status == 'pending');
    }

    // 發布的薪資單：員工只能看自己的，管理者發布
    match /payslips/{id} {
      allow get: if isAdmin() || (bound() && (resource == null || resource.data.empId == myEmpId()));
      allow list: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || seenOnly();
    }

    // 員工確認打卡明細（確認無誤／有問題）
    match /payConfirm/{id} {
      allow get: if isAdmin() || (bound() && (resource == null || resource.data.empId == myEmpId()));
      allow list: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow create, update: if isAdmin()
                    || (bound() && request.resource.data.empId == myEmpId()
                        && id == request.resource.data.month + '_' + myEmpId()
                        && request.resource.data.status in ['ok', 'issue', 'none']);
      allow delete: if isAdmin();
    }

    // 薪資：只有管理者能讀寫
    match /payRates/{id} {
      allow read, write: if isAdmin();
    }
    match /payroll/{month} {
      allow read, write: if isAdmin();
    }

    // 打卡地點：已綁定員工可讀，管理者可改
    match /locations/{id} {
      allow read: if bound();
      allow write: if isAdmin();
    }

    // 打卡位置檢查：班別有設定打卡地點時，座標必須在範圍內
    function shiftPath(id) { return /databases/$(database)/documents/shiftTypes/$(id); }
    function locPath(id) { return /databases/$(database)/documents/locations/$(id); }
    function inRange(d, lid) {
      return exists(locPath(lid))
        && d.lat is number && d.lng is number
        && math.abs(d.lat - get(locPath(lid)).data.lat) <= get(locPath(lid)).data.dLat
        && math.abs(d.lng - get(locPath(lid)).data.lng) <= get(locPath(lid)).data.dLng;
    }
    // 下班打卡且班別有設定下班地點 → 用下班地點；否則用上班地點
    function needLoc(d) {
      return (d.type == 'out' && get(shiftPath(d.shiftId)).data.get('outLocationId', '') != '')
        ? get(shiftPath(d.shiftId)).data.outLocationId
        : get(shiftPath(d.shiftId)).data.get('locationId', '');
    }
    // 範圍外打卡：必須標記 outOfRange 並填寫原因（至少 2 個字）
    function hasReason(d) {
      return d.get('outOfRange', false) == true && d.get('reason', '') is string && d.get('reason', '').size() >= 2;
    }
    function locationOk(d) {
      return hasReason(d)
        || !('shiftId' in d) || d.shiftId == null || d.shiftId == ''
        || !exists(shiftPath(d.shiftId))
        || needLoc(d) == ''
        || inRange(d, needLoc(d));
    }

    // 打卡：只能用自己的身分、伺服器時間、在打卡範圍內新增；不能修改或刪除
    match /attendance/{id} {
      allow read: if isAdmin() || (bound() && resource.data.empId == myEmpId());
      allow create: if (bound()
                    && request.resource.data.empId == myEmpId()
                    && request.resource.data.ts == request.time
                    && locationOk(request.resource.data))
                    // 管理者匯入舊系統打卡紀錄
                    || (isAdmin() && (request.resource.data.imported == true || request.resource.data.makeup == true));
      // 管理者重新匯入同一筆（覆蓋）
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
